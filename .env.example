# ============================================================
# Cấu hình môi trường (KHÔNG commit file .env, chỉ commit .env.example)
# Hướng dẫn: copy file này thành .env rồi điều chỉnh cho phù hợp
#   Windows/PowerShell:  copy .env.example .env
#   macOS/Linux:         cp .env.example .env
# ============================================================

# PostgreSQL (Docker) — docker-compose.yml tự đọc file .env này
# LƯU Ý: mật khẩu phải KHỚP với password trong backend/.env (DATABASE_URL)
POSTGRES_USER=balo_admin
POSTGRES_PASSWORD=change_me_db_password
POSTGRES_DB=balo_store