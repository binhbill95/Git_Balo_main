# PostgreSQL (Docker) - cổng 5433
# LƯU Ý: đổi mật khẩu phải khớp với POSTGRES_PASSWORD trong file .env (thư mục gốc)
DATABASE_URL="postgresql://balo_admin:change_me_db_password@localhost:5433/balo_store?schema=public"

# Server
PORT=3000
NODE_ENV=development

# JWT
JWT_ACCESS_SECRET="change_me_access"
JWT_REFRESH_SECRET="change_me_refresh"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# CORS origin (frontend dev)
CLIENT_URL="http://localhost:5173"